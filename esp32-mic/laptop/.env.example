# =============================================================================
#  Whisper Assistant — laptop app configuration.
#  Copy this file to ".env" and fill in the values. The ".env" file is NOT
#  committed to git (see .gitignore), so your keys stay private.
# =============================================================================

# --- Required: your DeepSeek API key (https://platform.deepseek.com) ---------
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat

# --- Speech-to-text ----------------------------------------------------------
#  "faster-whisper" = runs locally (no key, downloads a model on first use)
#  "openai"         = uses the OpenAI Whisper API (needs OPENAI_API_KEY below)
STT_BACKEND=faster-whisper
WHISPER_MODEL=base

# Only needed if STT_BACKEND=openai
OPENAI_API_KEY=

# --- ESP32 target (the laptop sends responses back here) --------------------
#  Usually leave ESP32_IP EMPTY: the app learns the ESP32's IP automatically
#  the first time the ESP32 connects. Set it only if auto-detection fails.
ESP32_IP=
ESP32_PORT=80

# --- Audio source ------------------------------------------------------------
#  "laptop" = record with the laptop's own microphone (sounddevice).
#  "esp32"  = the ESP32 captures audio with an INMP441 I2S mic and streams it
#             here over Wi-Fi. Must match AUDIO_SOURCE_ESP32 in the firmware's
#             config.h (set it to true there too).
AUDIO_SOURCE=laptop

# --- Debug audio -------------------------------------------------------------
#  When true (and AUDIO_SOURCE=esp32), save the last utterance to
#  debug_audio/last.wav so you can listen back and check mic quality.
DEBUG_AUDIO=false

# --- Laptop server -----------------------------------------------------------
#  LAPTOP_HOST must stay 0.0.0.0 so the ESP32 can reach the laptop on the LAN.
LAPTOP_HOST=0.0.0.0
LAPTOP_PORT=5000
