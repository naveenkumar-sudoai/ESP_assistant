# =============================================================================
#  Whisper Assistant (Simple) — laptop app configuration.
#  Copy this file to ".env" and fill in the values. The ".env" file is NOT
#  committed to git (see .gitignore), so your keys stay private.
# =============================================================================

# --- Required: your DeepSeek API key (https://platform.deepseek.com) ---------
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat

# --- Speech-to-text ----------------------------------------------------------
#  "faster-whisper" = runs locally (no key, downloads a model on first use)
#  "openai"         = uses the OpenAI Whisper API (needs OPENAI_API_KEY below)
STT_BACKEND=faster-whisper
WHISPER_MODEL=base

# Only needed if STT_BACKEND=openai
OPENAI_API_KEY=

# --- ESP32 target (the laptop sends answers back here) -----------------------
#  Usually leave ESP32_IP EMPTY: the app learns the ESP32's IP automatically
#  when the ESP32 registers on boot. Set it only if auto-detection fails.
ESP32_IP=
ESP32_PORT=80

# --- Laptop server -----------------------------------------------------------
#  LAPTOP_HOST must stay 0.0.0.0 so the ESP32 can reach the laptop on the LAN.
LAPTOP_HOST=0.0.0.0
LAPTOP_PORT=5000
